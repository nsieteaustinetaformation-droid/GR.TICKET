# ==========================================
# GR TICKET — CONFIGURATION DE L'ENVIRONNEMENT
# Nom officiel : GR Ticket — par Goldman Record Company
# Aucun secret réel dans ce fichier.
# Copiez ce fichier vers .env.local pour le dev.
# ==========================================

# APPLICATION
NEXT_PUBLIC_APP_URL=http://localhost:3010
NODE_ENV=development

# SUPABASE (Base de données PostgreSQL & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# STOCKAGE D'IMAGES
# Exécutez supabase/schema.sql : il crée le bucket public "grtk-images".
# Avec de vraies valeurs Supabase ci-dessus, POST /api/v1/uploads enregistre
# les images compressées dans ce bucket. Sinon l'API répond en mode démo avec
# la data URL fournie par le navigateur (aperçu immédiat, non persistant).

# SÉCURITÉ & SIGNATURE CRYPTOGRAPHIQUE (HMAC-SHA256)
# Clé secrète utilisée pour signer les QR codes et les sessions de démonstration.
TICKET_SIGNATURE_SECRET=changez_ce_secret_en_production_par_une_cle_aleatoire_64_chars

# Tâches planifiées : header `x-cron-secret` ou `Authorization: Bearer <secret>`
CRON_SECRET=changez_ce_secret_cron

# Webhooks paiement : signature HMAC `x-grtk-signature` (secret serveur uniquement)
PAYMENT_WEBHOOK_SECRET=changez_ce_secret_webhook

# PAIEMENTS CONGO (XAF) - ABSTRACTION FOURNISSEURS
# Providers disponibles: sandbox, manual, mtn_cg, airtel_cg
ACTIVE_PAYMENT_PROVIDER=sandbox

# MTN Mobile Money Congo (API / Agrégateur)
MTN_CONGO_API_URL=https://api.mtn.cg/momo
MTN_CONGO_SUBSCRIPTION_KEY=votre_cle_abonnement_mtn
MTN_CONGO_USER_ID=votre_user_id
MTN_CONGO_API_KEY=votre_api_key
MTN_CONGO_TARGET_ENVIRONMENT=sandbox

# Airtel Money Congo (API / Agrégateur)
AIRTEL_CONGO_API_URL=https://openapi.airtel.cg
AIRTEL_CONGO_CLIENT_ID=votre_client_id_airtel
AIRTEL_CONGO_CLIENT_SECRET=votre_client_secret_airtel

# WHATSAPP BUSINESS CLOUD API (Meta Graph API)
WHATSAPP_API_TOKEN=votre_token_meta_cloud_api
WHATSAPP_PHONE_NUMBER_ID=votre_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=votre_waba_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=votre_verify_token
